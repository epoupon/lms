<?xml version="1.0" encoding="UTF-8" ?>
<messages xmlns:if="Wt.WTemplate.conditions">

<message id="Lms.Settings.lastfm.template.form">
	<form class="row g-3">
		<legend>${tr:Lms.Settings.lastfm}</legend>
		<div class="col-lg-12">
			<div class="form-check">
				${enable-scrobbling class="form-check-input"}
				<label class="form-check-label" for="${id:enable-scrobbling}">
					${tr:Lms.Settings.lastfm-enable-scrobbling}
				</label>
			</div>
		</div>
	</form>
	<hr/>
	${save-btn class="btn btn-primary me-1"}${discard-btn class="btn btn-secondary"}
</message>

<message id="Lms.Settings.lastfm.template.card">
	<div class="card mt-3">
		<div class="card-header d-flex align-items-center gap-2">
			${tr:Lms.Settings.lastfm-card-title}
			${<if-linked>}<span class="badge text-bg-success">${tr:Lms.Settings.lastfm-linked}</span>${</if-linked>}
		</div>
		<div class="card-body d-flex align-items-center gap-2">
			${<if-linked>}${unlink-btn class="btn btn-secondary"}${</if-linked>}
			${<if-unlinked>}${link-btn class="btn btn-secondary"}${</if-unlinked>}
		</div>
	</div>
</message>

<message id="Lms.Settings.lastfm.template.link-modal">
	<div class="modal fade" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">${tr:Lms.Settings.lastfm-link-modal-title}</h5>
				</div>
				<div class="modal-body">
					<p>${tr:Lms.Settings.lastfm-link-modal-help}</p>
					<div class="mb-3">
						<label class="form-label">${tr:Lms.Settings.lastfm-api-key}</label>
						${api-key class="form-control"}
					</div>
					<div class="mb-3">
						<label class="form-label">${tr:Lms.Settings.lastfm-api-secret}</label>
						<div class="input-group">
							${api-secret class="form-control"}
							${api-secret-visibility-btn class="btn btn-outline-secondary"}
						</div>
					</div>
					${auth-anchor-container}
				</div>
				<div class="modal-footer">
					${authorize-btn class="btn btn-primary me-1"}${done-btn class="btn btn-success me-1"}${cancel-btn class="btn btn-secondary"}
				</div>
			</div>
		</div>
	</div>
</message>

<message id="Lms.Settings.lastfm.template.unlink-confirm">
	<div class="modal fade" tabindex="-1">
		<div class="modal-dialog">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title">${tr:Lms.Settings.lastfm-unlink-confirm-title}</h5>
				</div>
				<div class="modal-body">
					${tr:Lms.Settings.lastfm-unlink-confirm-body}
				</div>
				<div class="modal-footer">
					${confirm-btn class="btn btn-danger me-1"}${cancel-btn class="btn btn-secondary"}
				</div>
			</div>
		</div>
	</div>
</message>

</messages>
