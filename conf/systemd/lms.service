[Unit]
Description=Lightweight Music Server
After=network.target

[Service]
Type=simple
Restart=on-failure
RestartSec=1
WorkingDirectory=/var/lms
ExecStart=/usr/bin/lms
User=lms
Group=lms
Environment=OMP_THREAD_LIMIT=1
Environment=MALLOC_MMAP_THRESHOLD_=1048576

[Install]
WantedBy=multi-user.target

